# Set the variables you need in your shell before running Python.
# Python does not automatically read this file.
HF_HOME=.cache/hf
VICARE_INDEX_DIR=chroma_db
VICARE_TOP_K=5
VICARE_CANDIDATE_POOL=80
VICARE_HYBRID_DENSE_DEPTH=200
VICARE_RRF_K=40
VICARE_DENSE_WEIGHT=0.5
VICARE_SPARSE_WEIGHT=0.5
# Uncalibrated demonstration threshold retained from the original notebook; NOT clinically validated.
VICARE_MIN_DENSE_SCORE=0.86
VICARE_MAX_QUESTION_CHARS=1000
VICARE_OLLAMA_HOST=http://127.0.0.1:11434
# Local generation model used in the submission.
# VICARE_OLLAMA_MODEL is still accepted as a backward-compatible fallback when VICARE_LLM_MODEL is unset.
# Startup reuses a running server. For a new local daemon, the defaults on this machine
# are D:\ollama\ollama.exe and D:\ollama_models. Optional explicit overrides:
# VICARE_OLLAMA_EXE=D:\ollama\ollama.exe
# VICARE_OLLAMA_MODELS=D:\ollama_models
# VICARE_OLLAMA_MODELS takes precedence over OLLAMA_MODELS for the new server process.
VICARE_LLM_MODEL=qwen3:4b-instruct
# VICARE_OLLAMA_MODEL=qwen3:4b-instruct
VICARE_MAX_OUTPUT_TOKENS=384
VICARE_OLLAMA_TIMEOUT=45
# Connection and /api/tags timeouts are capped at 3 seconds. /api/chat uses the timeout above.
VICARE_TORCH_THREADS=8
